# Przykładowa konfiguracja .env dla pojedynczego konta Tuya
TUYA_ACCESS_ID=twoje_access_id
TUYA_ACCESS_KEY=twoje_access_key
# Opcjonalnie: lista ID urządzeń do monitorowania (oddzielone przecinkami)
TUYA_DEVICE_IDS=bf874f7ae72aca1fc23op0

# --- ALTERNATYWNA KONFIGURACJA DLA WIELU KONT ---
# Użyj TUYA_ACCOUNTS_JSON zamiast powyższych zmiennych dla wielu kont
# Format JSON: lista obiektów z kluczami: access_id, access_key, devices (opcjonalnie)

# Przykład dla dwóch kont Tuya:
# TUYA_ACCOUNTS_JSON=[
#   {
#     "access_id": "konto1_access_id",
#     "access_key": "konto1_access_key",
#     "devices": ["device_id_1", "device_id_2"]
#   },
#   {
#     "access_id": "konto2_access_id", 
#     "access_key": "konto2_access_key",
#     "devices": ["device_id_3"]
#   }
# ]

# --- POWIADOMIENIA TELEGRAM (opcjonalne) ---
# Utwórz bota: https://t.me/BotFather → /newbot
# Chat ID: wyślij wiadomość do bota, potem otwórz https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Godzina wysyłki raportu dziennego (0-23, czas lokalny, domyślnie 21)
DAILY_REPORT_HOUR=21
# Przesunięcie czasu LOKALNEGO względem UTC (Polska: 2 latem CEST, 1 zimą CET).
# Timestampy w bazie to epoch UTC; ta wartość jest nadpisana dynamiczną funkcją
# get_timezone_offset() w config.py (używa zoneinfo), która automatycznie
# dostosowuje się do DST.
# Ustawienie tutaj służy tylko jako fallback dla środowisk bez zoneinfo.
SERVER_TIMEZONE_OFFSET=2
